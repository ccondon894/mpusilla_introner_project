# ============================================================
# Micromonas pusilla Introner Project - Master Workflow
# ============================================================
#
# This is the main entry point for the analysis pipeline.
# Run with: snakemake --configfile config/config.yaml --cores N
#
# ============================================================

import os
from pathlib import Path

# ============================================================
# CONFIGURATION
# ============================================================

# Ensure config is loaded
if not config:
    raise ValueError("Configuration not loaded. Run with --configfile config/config.yaml")

# Project root directory
PROJECT_ROOT = Path(workflow.basedir).parent

# Sample lists from config
GROUP1_SAMPLES = config["samples"]["group1"]
GROUP2_SAMPLES = config["samples"]["group2"]
ALL_SAMPLES = config["samples"]["all"]
REFERENCE = config["samples"]["reference"]["group1"]

# Output directories
RESULTS = PROJECT_ROOT / "results"
GENOTYPING_DIR = RESULTS / "genotyping"
ANNOTATIONS_DIR = RESULTS / "annotations"
ASSEMBLIES_DIR = RESULTS / "assemblies"
EVOLUTION_DIR = RESULTS / "evolution"
SNP_DIR = RESULTS / "snp_popgen"
EXPRESSION_DIR = RESULTS / "expression"
GO_DIR = RESULTS / "go_enrichment"
FIGURES_DIR = RESULTS / "figures"
GENOME_ALIGNMENT_DIR = RESULTS / "genome_alignment"
ALIGNMENT_DIR = EVOLUTION_DIR / "alignments"

# Samples with augmented GTFs from StringTie de novo annotation.
# For these samples, downstream rules use the augmented+renamed GTF
# for a more complete gene set.
AUGMENTED_GTF_SAMPLES = {"RCC1749"}


def get_gtf(sample):
    """Return the best available GTF for a sample.

    Returns the augmented+renamed GTF for samples with StringTie
    de novo annotations, otherwise the standard lifted-over GTF.
    """
    if sample in AUGMENTED_GTF_SAMPLES:
        return ANNOTATIONS_DIR / f"{sample}.augmented.renamed.gtf"
    return ANNOTATIONS_DIR / f"{sample}.gtf"


# ============================================================
# WILDCARD CONSTRAINTS
# ============================================================
# Constrain wildcards to prevent unbounded matching and DAG explosion

# Build regex pattern from sample names
SAMPLE_PATTERN = "|".join(ALL_SAMPLES)

wildcard_constraints:
    sample = SAMPLE_PATTERN,
    query = SAMPLE_PATTERN,
    target = SAMPLE_PATTERN,
    ref = "CCMP1545_v3|RCC1749_assembly",
    flank_length = r"\d+"

# ============================================================
# MODULE SELECTION
# ============================================================
#
# By default, all modules are loaded. To speed up DAG building,
# specify which modules to load via --config modules=X
#
# Available modules:
#   genotyping  - Core genotyping pipeline (rules 00-06)
#   evolution   - Evolution analysis (rules 10-12)
#   snp         - SNP population genetics (rules 20-24)
#   expression  - Expression & GO analysis (rules 30-32, 40)
#   all         - Load all modules (default)
#
# Examples:
#   snakemake --configfile config/config.yaml --cores 8 genotype_matrix --config modules=genotyping
#   snakemake --configfile config/config.yaml --cores 8 evolution_all --config modules=genotyping,evolution
#   snakemake --configfile config/config.yaml --cores 8 full_pipeline --config modules=all
#
# ============================================================

# Parse module selection from config
MODULES = config.get("modules", "all")
if isinstance(MODULES, str):
    MODULES = [m.strip() for m in MODULES.split(",")]

# Reject removed or misspelled modules before constructing the DAG.
SUPPORTED_MODULES = {"all", "genotyping", "evolution", "snp", "expression"}
unknown_modules = set(MODULES) - SUPPORTED_MODULES
if unknown_modules:
    raise ValueError(
        f"Unsupported workflow modules: {sorted(unknown_modules)}. "
        f"Available modules: {sorted(SUPPORTED_MODULES)}"
    )

# Determine which module groups to load
LOAD_ALL = "all" in MODULES
LOAD_GENOTYPING = LOAD_ALL or "genotyping" in MODULES
LOAD_EVOLUTION = LOAD_ALL or "evolution" in MODULES
LOAD_SNP = LOAD_ALL or "snp" in MODULES
LOAD_EXPRESSION = LOAD_ALL or "expression" in MODULES

# ============================================================
# INCLUDE RULE FILES (conditional based on module selection)
# ============================================================

# Core genotyping pipeline (always needed as foundation)
if LOAD_GENOTYPING or LOAD_EVOLUTION or LOAD_SNP or LOAD_EXPRESSION:
    include: "rules/00_data_prep.smk"
    include: "rules/03_gtf_liftover.smk"
    include: "rules/04_blast_genotyping.smk"
    include: "rules/05_ortholog_detection.smk"
    include: "rules/06_coverage_calling.smk"
    include: "rules/07_shared_locus_annotation.smk"

# Evolution analysis (Iteration 2)
if LOAD_EVOLUTION:
    include: "rules/10_evolution_analysis.smk"
    include: "rules/12_genome_alignment_circos.smk"
    include: "rules/13_non_introner_introns.smk"
    include: "rules/14_introner_positional_analysis.smk"
    include: "rules/15_shared_introner_divergence.smk"
    include: "rules/16_sfs_inference.smk"
    include: "rules/17_canonical_intron_dxy.smk"
    include: "rules/18_cds_position.smk"
    include: "rules/27_mating_type_audit.smk"

# SNP population genetics (Iteration 3)
if LOAD_SNP:
    include: "rules/20_snp_calling.smk"
    include: "rules/21_snp_popgen.smk"
    include: "rules/22_phylogenetics.smk"
    include: "rules/23_demography.smk"
    include: "rules/24_selection.smk"
    include: "rules/25_recombination_comparisons.smk"
    include: "rules/26_manuscript_figures.smk"

# Expression analysis (Iteration 4)
if LOAD_EXPRESSION:
    include: "rules/30_expression.smk"
    include: "rules/31_isoform_analysis.smk"
    include: "rules/32_glm_modeling.smk"
    include: "rules/33_functional_expression.smk"
    include: "rules/34_expression_sensitivities.smk"
    include: "rules/35_expression_figures.smk"
    include: "rules/36_expression_comparisons.smk"
    # GO enrichment (Iteration 4)
    include: "rules/40_go_enrichment.smk"

# ============================================================
# TARGET RULES
# ============================================================

rule all:
    """
    Default target: Generate final genotype matrix

    The core genotyping pipeline produces:
    - genotype_matrix.tsv: Annotated matrix from ortholog detection
    - genotype_matrix.final.tsv: Coverage-validated matrix
    """
    input:
        # Core genotyping pipeline outputs (coverage-validated)
        GENOTYPING_DIR / "genotype_matrix.final.tsv",
        # Sample GTF annotations
        expand(ANNOTATIONS_DIR / "{sample}.gtf", sample=ALL_SAMPLES),


rule genotype_matrix:
    """
    Target: Generate genotype matrix (without coverage validation)
    """
    input:
        GENOTYPING_DIR / "genotype_matrix.tsv"


rule genotype_matrix_validated:
    """
    Target: Generate coverage-validated genotype matrix
    """
    input:
        GENOTYPING_DIR / "genotype_matrix.final.tsv"


rule gtf_annotations:
    """
    Target: Generate all GTF annotations only
    """
    input:
        expand(ANNOTATIONS_DIR / "{sample}.gtf", sample=ALL_SAMPLES)


rule blast_candidates:
    """
    Target: Generate BLAST candidate loci only
    """
    input:
        expand(GENOTYPING_DIR / "blast_results" / "{sample}.candidate_loci.filtered.fa",
               sample=ALL_SAMPLES)


# ============================================================
# EVOLUTION ANALYSIS TARGETS (Iteration 2)
# ============================================================

if LOAD_EVOLUTION:
    rule file_setup:
        """
        Target: Pre-generate classification JSON files for evolution analysis.

        Running this first allows subsequent runs to skip checkpoint evaluation,
        significantly speeding up DAG building.
        """
        input:
            rules.classify_all_samples_orthologs.output.classification_100bp,
            rules.classify_all_samples_orthologs.output.classification_200bp,
            rules.classify_group1_orthologs.output.classification_100bp,
            rules.classify_group1_orthologs.output.classification_200bp

    rule evolution_all:
        """
        Target: Complete evolution analysis pipeline (Iteration 2)

        Includes:
        - Consensus sequence building for flanking regions
        - All-samples fixation category analysis (Fixed Group1, Fixed Group2, etc.)
        - Group1 frequency-based analysis (present in 1-11 samples)
        - Current gain/loss inference is provided by rule 16 SFS targets;
          the deprecated PHDR/AHDR workflow was removed in May 2026
        """
        input:
            # Evolution diversity metrics (100bp and 200bp flanks)
            expand(EVOLUTION_DIR / "diversity_metrics" / "all_samples_diversity_metrics_{flank_length}bp.tsv",
                   flank_length=[100, 200]),
            expand(EVOLUTION_DIR / "diversity_metrics" / "group1_diversity_metrics_{flank_length}bp.tsv",
                   flank_length=[100, 200]),
            # Evolution plots
            expand(EVOLUTION_DIR / "plots" / "all_samples_box_plots_{flank_length}bp.png",
                   flank_length=[100, 200]),
            expand(EVOLUTION_DIR / "plots" / "frequency_line_plots_{flank_length}bp_present_spectrum.png",
                   flank_length=[100, 200]),
            expand(EVOLUTION_DIR / "plots" / "frequency_box_plots_{flank_length}bp_present_spectrum.png",
                   flank_length=[100, 200])


    rule genome_alignment_circos:
        """
        Target: Whole-genome MUMmer alignment + Circos plot (CCMP1545 vs RCC1749)

        Produces synteny dot plot and circos visualization comparing
        the intronerful and intronerless reference genomes.
        """
        input:
            GENOME_ALIGNMENT_DIR / "mummer" / f"{REFERENCE}_vs_{config['samples']['reference']['group2']}.1delta",
            FIGURES_DIR / "genome_alignment" / f"{REFERENCE}_vs_{config['samples']['reference']['group2']}.png",
            GENOME_ALIGNMENT_DIR / "circos" / "circos.png",
            GENOME_ALIGNMENT_DIR / "circos" / "circos.svg",
            GENOME_ALIGNMENT_DIR / "circos" / "circos.pycirclize.png",
            GENOME_ALIGNMENT_DIR / "circos" / "circos.pycirclize.svg"


    rule genotyping_evolution_all:
        """
        Target: Complete genotyping + evolution pipeline (Iterations 1 + 2)

        Runs the full core pipeline:
        - GTF liftover annotations for all samples
        - BLAST-based introner candidate detection
        - Ortholog detection and genotype matrix construction
        - Evolution analysis (all-samples + Group1 frequency)
        - Group 1 frequency analysis (gain/loss inference is in rule 16)
        """
        input:
            # Iteration 1: Genotyping outputs
            GENOTYPING_DIR / "genotype_matrix.tsv",
            expand(ANNOTATIONS_DIR / "{sample}.gtf", sample=ALL_SAMPLES),
            # Iteration 2: Evolution outputs
            expand(EVOLUTION_DIR / "diversity_metrics" / "all_samples_diversity_metrics_{flank_length}bp.tsv",
                   flank_length=[100, 200]),
            expand(EVOLUTION_DIR / "diversity_metrics" / "group1_diversity_metrics_{flank_length}bp.tsv",
                   flank_length=[100, 200])


# ============================================================
# SNP POPULATION GENETICS TARGETS (Iteration 3)
# ============================================================

if LOAD_SNP:
    rule snp_popgen_all:
        """
        Target: Complete SNP population genetics pipeline (Iteration 3)

        Includes:
        - SNP calling with GATK
        - VCF filtering and 4-fold degenerate site extraction
        - Phylogenetic analysis with IQ-TREE
        - Demographic modeling with moments
        - Selection and population structure analysis
        """
        input:
            # SNP calling outputs
            SNP_DIR / "vcf" / "mpusilla.joint.vcf.gz",
            # Filtered VCFs
            SNP_DIR / "vcf" / "mpusilla.snps.4d.notMT.vcf.gz",
            SNP_DIR / "vcf" / "mpusilla.snps.4d.notMT.intronerful.vcf.gz",
            # Phylogenetics
            SNP_DIR / "phylogenetics" / "mpusilla.snps.4d.min4.phy.treefile",
            FIGURES_DIR / "snp_popgen" / "phylogenetic_tree.pdf",
            # Demography
            SNP_DIR / "demography" / "observed.2d.fs",
            FIGURES_DIR / "2D_afs.pdf",
            # Selection analysis
            SNP_DIR / "selection" / "tajimas_d.tsv",
            SNP_DIR / "selection" / "pca" / "mpusilla.snps.eigenvec",
            SNP_DIR / "selection" / "ld" / "ld_summary_by_distance.tsv",
            FIGURES_DIR / "snp_popgen" / "pca.pdf",
            FIGURES_DIR / "ld_decay.pdf"


# ============================================================
# EXPRESSION & GO ANALYSIS TARGETS (Iteration 4)
# ============================================================

if LOAD_EXPRESSION:
    rule expression_go_all:
        """
        Target: Complete expression and GO analysis pipeline (Iteration 4)

        Includes:
        - RNA-seq quantification with featureCounts
        - SQANTI3 isoform classification
        - Shannon diversity analysis
        - NMD analysis
        - GLM statistical modeling
        - GO enrichment analysis
        """
        input:
            # Expression quantification
            EXPRESSION_DIR / "counts" / "merged_counts_matrix.csv",
            EXPRESSION_DIR / "sqanti3" / "parsed_sqanti3_data.tsv",
            # Isoform analysis
            EXPRESSION_DIR / "isoform_analysis" / "diversity" / "shannon_diversity_per_gene.csv",
            EXPRESSION_DIR / "isoform_analysis" / "nmd" / "nmd_introner_analysis.txt",
            # GLM modeling
            rules.expression_analysis_complete.input,
            # GO enrichment
            GO_DIR / "mappings" / "gene2go.json",
            GO_DIR / "results" / "introner_group_go_enrichment.tsv",
            # Key figures
            FIGURES_DIR / "shannon_diversity_distribution.pdf",
            FIGURES_DIR / "go_enrichment_heatmap.pdf",
            FIGURES_DIR / "go_enrichment_top_terms.pdf"


# ============================================================
# FULL PIPELINE TARGET (requires all modules)
# ============================================================

if LOAD_ALL:
    rule full_pipeline:
        """
        Target: Run complete pipeline (all iterations)

        Runs all analysis components in order:
        1. Core genotyping (genotype matrix)
        2. Evolution analysis
        3. SNP population genetics
        4. Expression & GO analysis
        """
        input:
            lambda wildcards: rules.additional_analyses_complete.input,
            # Iteration 1-2: Genotyping & Evolution
            GENOTYPING_DIR / "genotype_matrix.tsv",
            expand(ANNOTATIONS_DIR / "{sample}.gtf", sample=ALL_SAMPLES),
            # Iteration 3: SNP popgen (key outputs)
            SNP_DIR / "vcf" / "mpusilla.snps.4d.notMT.vcf.gz",
            FIGURES_DIR / "snp_popgen" / "phylogenetic_tree.pdf",
            FIGURES_DIR / "snp_popgen" / "pca.pdf",
            # Iteration 4: Expression & GO
            EXPRESSION_DIR / "counts" / "merged_counts_matrix.csv",
            rules.expression_analysis_complete.input,
            GO_DIR / "results" / "introner_group_go_enrichment.tsv",
            FIGURES_DIR / "go_enrichment_heatmap.pdf",
            FIGURES_DIR / "go_enrichment_top_terms.pdf"


# ============================================================
# UTILITY RULES
# ============================================================

rule clean:
    """
    Clean all generated files (use with caution!)
    """
    shell:
        """
        echo "This would remove all results. Run manually if sure."
        echo "rm -rf {RESULTS}/*"
        """


rule dag:
    """
    Generate DAG visualization
    """
    output:
        "dag.png"
    shell:
        """
        snakemake --dag | dot -Tpng > {output}
        """


# ============================================================
# WORKFLOW INFORMATION
# ============================================================

onstart:
    print("=" * 60)
    print("Micromonas pusilla Introner Project")
    print("=" * 60)
    print(f"Project root: {PROJECT_ROOT}")
    print(f"Samples: {len(ALL_SAMPLES)} total ({len(GROUP1_SAMPLES)} Group1, {len(GROUP2_SAMPLES)} Group2)")
    print(f"Reference: {REFERENCE}")
    print(f"Modules loaded: {', '.join(MODULES)}")
    print("=" * 60)


onsuccess:
    print("=" * 60)
    print("Workflow completed successfully!")
    print("=" * 60)


onerror:
    print("=" * 60)
    print("Workflow failed. Check logs for details.")
    print("=" * 60)


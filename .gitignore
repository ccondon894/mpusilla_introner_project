# ============================================================
# Conda environments and external tools
# ============================================================
# Ignore materialized env directories (e.g., workflow/envs/dadi-env/) but
# keep the .yaml specs tracked so --use-conda rules are reproducible.
workflow/envs/*/
workflow/tools/*
!workflow/tools/introner-caller

